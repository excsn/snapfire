{
  "openapi": "3.0.3",
  "info": { "title": "Board", "version": "1.0.0" },
  "paths": {
    "/board": {
      "get": {
        "operationId": "getBoard",
        "responses": {
          "200": {
            "description": "the field's clock and what is on it",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Board" } } }
          }
        }
      }
    },
    "/weather": {
      "get": {
        "operationId": "getWeather",
        "responses": {
          "200": {
            "description": "the field, eventually",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Weather" } } }
          }
        }
      }
    },
    "/gates": {
      "get": {
        "operationId": "listGateChanges",
        "responses": {
          "200": {
            "description": "gate changes, from the slowest system on the field",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/GateChange" } } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Board": {
        "type": "object",
        "required": ["at", "arrivals", "departures"],
        "properties": {
          "at": { "type": "string" },
          "arrivals": { "type": "array", "items": { "$ref": "#/components/schemas/Flight" } },
          "departures": { "type": "array", "items": { "$ref": "#/components/schemas/Flight" } }
        }
      },
      "Flight": {
        "type": "object",
        "required": ["flight", "city", "scheduled", "expected", "status", "code", "gate"],
        "properties": {
          "flight": { "type": "string" },
          "city": { "type": "string" },
          "scheduled": { "type": "string" },
          "expected": { "type": "string" },
          "status": { "type": "string" },
          "code": { "type": "string" },
          "gate": { "type": "string" }
        }
      },
      "Weather": {
        "type": "object",
        "required": ["field", "wind", "visibility", "celsius"],
        "properties": {
          "field": { "type": "string" },
          "wind": { "type": "string" },
          "visibility": { "type": "string" },
          "celsius": { "type": "number", "format": "double" }
        }
      },
      "GateChange": {
        "type": "object",
        "required": ["flight", "was", "now", "at"],
        "properties": {
          "flight": { "type": "string" },
          "was": { "type": "string" },
          "now": { "type": "string" },
          "at": { "type": "string" }
        }
      }
    }
  }
}
