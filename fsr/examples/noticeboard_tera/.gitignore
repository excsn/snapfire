app/generated/
app/tsconfig.json
app/tsconfig.build.json
# fetched by `fsr types`; read by the editor and tsc, never served
app/types/
# written by snapfirec and `fsr prerender app`; rebuilt from the sources
app/dist/
# written by `fsr dev` and `fsr test`: the served import map and the spec build
app/.fsr/
