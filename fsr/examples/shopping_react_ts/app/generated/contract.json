{
  "types": {
    "Product": {
      "record": {
        "fields": [
          {
            "name": "id",
            "type": "i64"
          },
          {
            "name": "name",
            "type": "str"
          },
          {
            "name": "brand",
            "type": "str"
          },
          {
            "name": "category",
            "type": "str"
          },
          {
            "name": "price_cents",
            "type": "i64"
          },
          {
            "name": "list_price_cents",
            "type": {
              "optional": "i64"
            }
          },
          {
            "name": "stock",
            "type": "i32"
          },
          {
            "name": "rating",
            "type": "f64"
          },
          {
            "name": "reviews",
            "type": "i32"
          },
          {
            "name": "description",
            "type": "str"
          },
          {
            "name": "tags",
            "type": {
              "list": "str"
            }
          },
          {
            "name": "attributes",
            "type": {
              "list": {
                "named": "Attribute"
              }
            }
          },
          {
            "name": "image",
            "type": {
              "named": "Image"
            }
          }
        ]
      }
    },
    "Attribute": {
      "record": {
        "fields": [
          {
            "name": "name",
            "type": "str"
          },
          {
            "name": "value",
            "type": "str"
          }
        ]
      }
    },
    "Image": {
      "record": {
        "fields": [
          {
            "name": "color",
            "type": "str"
          },
          {
            "name": "emoji",
            "type": "str"
          }
        ]
      }
    },
    "OrderLine": {
      "record": {
        "fields": [
          {
            "name": "product_id",
            "type": "i64"
          },
          {
            "name": "quantity",
            "type": "i32"
          }
        ]
      }
    },
    "Order": {
      "record": {
        "fields": [
          {
            "name": "id",
            "type": "i64"
          },
          {
            "name": "total_cents",
            "type": "i64"
          },
          {
            "name": "lines",
            "type": {
              "list": {
                "named": "PlacedLine"
              }
            }
          }
        ]
      }
    },
    "PlacedLine": {
      "record": {
        "fields": [
          {
            "name": "product_id",
            "type": "i64"
          },
          {
            "name": "name",
            "type": "str"
          },
          {
            "name": "quantity",
            "type": "i32"
          },
          {
            "name": "line_cents",
            "type": "i64"
          }
        ]
      }
    },
    "AddToCart": {
      "record": {
        "fields": [
          {
            "name": "product_id",
            "type": "i64"
          },
          {
            "name": "quantity",
            "type": "i64"
          }
        ]
      }
    },
    "RemoveFromCart": {
      "record": {
        "fields": [
          {
            "name": "product_id",
            "type": "i64"
          }
        ]
      }
    },
    "Session": {
      "record": {
        "fields": [
          {
            "name": "cart",
            "type": {
              "map": "i64"
            }
          }
        ]
      }
    }
  },
  "services": {
    "shopping": {
      "methods": {
        "listProducts": {
          "params": [
            {
              "name": "q",
              "type": {
                "optional": "str"
              }
            },
            {
              "name": "category",
              "type": {
                "optional": "str"
              }
            },
            {
              "name": "tag",
              "type": {
                "optional": "str"
              }
            }
          ],
          "returns": {
            "list": {
              "named": "Product"
            }
          }
        },
        "getProduct": {
          "params": [
            {
              "name": "id",
              "type": "i64"
            }
          ],
          "returns": {
            "named": "Product"
          }
        },
        "placeOrder": {
          "params": [
            {
              "name": "lines",
              "type": {
                "list": {
                  "named": "OrderLine"
                }
              }
            }
          ],
          "returns": {
            "named": "Order"
          }
        }
      }
    }
  }
}
