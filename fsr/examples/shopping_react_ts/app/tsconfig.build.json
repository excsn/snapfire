{
  "compilerOptions": {
    "target": "es2022",
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "jsx": "react-jsx",
    "paths": {
      "@app/*": ["./*"],
      "@routes/*": ["./routes/*"],
      "@src/*": ["./src/*"],
      "@schemas/*": ["./schemas/*"],
      "@generated/*": ["./generated/*"],
      "@ext/*": ["./ext/*"]
    }
  },
  "include": ["src/**/*", "ext/**/*", "routes/cart/page.tsx", "routes/layout.tsx", "routes/page.tsx", "routes/product/[id]/page.modal.tsx", "routes/product/[id]/page.tsx", "generated/islands.ts", "generated/client.ts"]
}
