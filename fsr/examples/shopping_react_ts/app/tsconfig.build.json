{
  "compilerOptions": {
    "target": "es2022",
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "jsx": "react-jsx",
    "paths": {
      "@app/*": ["./*"],
      "@routes/*": ["./routes/*"],
      "@src/*": ["./src/*"],
      "@schemas/*": ["./schemas/*"],
      "@generated/*": ["./generated/*"],
      "@ext/*": ["./ext/*"]
    }
  },
  "include": ["src/**/*", "ext/**/*", "generated/islands.ts", "generated/client.ts"],
  "files": ["routes/cart/page.island0.tsx", "routes/product/[id]/page.island0.tsx", "routes/product/[id]/page.modal.island0.tsx"]
}
