{
  "openapi": "3.0.3",
  "info": {
    "title": "Waves",
    "version": "1.0.0"
  },
  "paths": {
    "/waves": {
      "get": {
        "operationId": "listWaves",
        "parameters": [
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "who",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "the inbox, under one view",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Summary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/people": {
      "get": {
        "operationId": "listPeople",
        "responses": {
          "200": {
            "description": "everyone on any wave, and whether they are here now",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Person"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/waves/{id}": {
      "get": {
        "operationId": "getWave",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "at",
            "in": "query",
            "description": "the step of the wave's log to show it after, the last step at most; the wave as it stands when absent, empty or not a number",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "one wave and every blip in it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Wave"
                }
              }
            }
          }
        }
      }
    },
    "/waves/{id}/blips/{blip}": {
      "patch": {
        "operationId": "editBlip",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "blip",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Rewritten"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "the blip as it now stands",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Blip"
                }
              }
            }
          }
        }
      }
    },
    "/waves/{id}/blips": {
      "post": {
        "operationId": "addBlip",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Written"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "the blip as it was kept",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Blip"
                }
              }
            }
          }
        }
      }
    },
    "/waves/{id}/blips/{blip}/gadgets/{block}/moves": {
      "post": {
        "operationId": "play",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "blip",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "block",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Move"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "the blip holding the board, after the move",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Blip"
                }
              }
            }
          }
        }
      }
    },
    "/waves/{id}/blips/{blip}/gadgets/{block}/close": {
      "post": {
        "operationId": "closeVote",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "blip",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "block",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Closer"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "the blip holding the vote; closed for good when its author asked, with a blip of theirs at the end of the wave announcing the result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Blip"
                }
              }
            }
          }
        }
      }
    },
    "/waves/{id}/blips/{blip}/gadgets/{block}/votes": {
      "post": {
        "operationId": "vote",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "blip",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "block",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Vote"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "the blip holding the vote, after the answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Blip"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Summary": {
        "type": "object",
        "required": [
          "id",
          "title",
          "participants",
          "blips",
          "last"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "participants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blips": {
            "type": "number",
            "format": "double"
          },
          "last": {
            "type": "string"
          }
        }
      },
      "Person": {
        "type": "object",
        "required": [
          "name",
          "here",
          "waves"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "here": {
            "type": "boolean"
          },
          "waves": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "Wave": {
        "type": "object",
        "required": [
          "id",
          "title",
          "participants",
          "blips",
          "step",
          "steps",
          "live",
          "change"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "participants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blips": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Blip"
            }
          },
          "step": {
            "type": "number",
            "format": "double",
            "description": "how many changes of the log the wave is shown after"
          },
          "steps": {
            "type": "number",
            "format": "double",
            "description": "how many changes the log holds"
          },
          "live": {
            "type": "boolean",
            "description": "whether this is the wave as it stands rather than a step of playback"
          },
          "change": {
            "$ref": "#/components/schemas/Change"
          }
        }
      },
      "Change": {
        "type": "object",
        "required": [
          "kind",
          "who",
          "at",
          "blip"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "description": "kept, amended, played, cleared, voted or closed; empty before the first change"
          },
          "who": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "blip": {
            "type": "string",
            "description": "the blip the change touched"
          }
        }
      },
      "Blip": {
        "type": "object",
        "required": [
          "id",
          "parent",
          "anchor",
          "who",
          "body",
          "at",
          "edited",
          "editors",
          "blocks",
          "replies",
          "lit"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "parent": {
            "type": "string"
          },
          "anchor": {
            "type": "string",
            "description": "the block of the parent this answers: its id, then the path of a list item inside it; empty for the whole blip"
          },
          "who": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "description": "the markdown, its blocks a blank line apart"
          },
          "at": {
            "type": "string"
          },
          "edited": {
            "type": "string"
          },
          "editors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Block"
            },
            "description": "the body as its top-level markdown blocks, each parsed on the server with raw HTML kept as text"
          },
          "replies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Blip"
            },
            "description": "the replies to the whole blip, then any whose block is gone"
          },
          "lit": {
            "type": "boolean",
            "description": "whether the step of playback shown kept or amended this blip"
          }
        }
      },
      "Block": {
        "type": "object",
        "required": [
          "id",
          "text",
          "parts",
          "gadget"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "the block's id, kept while its text changes"
          },
          "text": {
            "type": "string",
            "description": "the block's markdown"
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Part"
            }
          },
          "gadget": {
            "$ref": "#/components/schemas/Gadget"
          }
        }
      },
      "Part": {
        "type": "object",
        "required": [
          "kind",
          "text",
          "href",
          "at",
          "children",
          "replies"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "description": "the element the part renders as; text for a run of text"
          },
          "text": {
            "type": "string",
            "description": "a text part's text, a code block's source or an image's alt"
          },
          "href": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "description": "the path of a part a reply can answer: its block's id, then its path inside the block; empty for any other part"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Part"
            }
          },
          "replies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Blip"
            },
            "description": "the replies anchored to this block"
          }
        }
      },
      "Rewritten": {
        "type": "object",
        "required": [
          "who",
          "body"
        ],
        "properties": {
          "who": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "block": {
            "type": "string",
            "description": "the block rewritten; empty or absent for the whole blip"
          }
        }
      },
      "Written": {
        "type": "object",
        "required": [
          "who",
          "parent",
          "anchor",
          "body"
        ],
        "properties": {
          "who": {
            "type": "string"
          },
          "parent": {
            "type": "string"
          },
          "anchor": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        }
      },
      "Move": {
        "type": "object",
        "required": [
          "who"
        ],
        "properties": {
          "who": {
            "type": "string"
          },
          "cell": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Cell": {
        "type": "object",
        "required": [
          "at",
          "mark"
        ],
        "properties": {
          "at": {
            "type": "integer",
            "format": "int64"
          },
          "mark": {
            "type": "string"
          }
        }
      },
      "Gadget": {
        "type": "object",
        "required": [
          "kind",
          "question",
          "cells",
          "turn",
          "won",
          "choices",
          "closed",
          "ended",
          "ends",
          "lit"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "description": "noughts, yesno or poll; empty for a block that is no gadget"
          },
          "question": {
            "type": "string",
            "description": "the question a vote asks"
          },
          "cells": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Cell"
            },
            "description": "a board's nine cells; empty for a vote"
          },
          "turn": {
            "type": "string"
          },
          "won": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Choice"
            },
            "description": "each answer a vote offers, in order; empty for a board"
          },
          "lit": {
            "type": "boolean",
            "description": "whether the step of playback shown moved on this gadget"
          },
          "closed": {
            "type": "boolean",
            "description": "whether its author closed the vote for good"
          },
          "ended": {
            "type": "boolean",
            "description": "whether the vote's deadline has passed"
          },
          "ends": {
            "type": "string",
            "description": "when voting ends, in UTC; empty for a vote with no deadline and for a board"
          }
        }
      },
      "Choice": {
        "type": "object",
        "required": [
          "answer",
          "count",
          "who"
        ],
        "properties": {
          "answer": {
            "type": "string"
          },
          "count": {
            "type": "number",
            "format": "double"
          },
          "who": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "everyone who gave this answer"
          }
        }
      },
      "Vote": {
        "type": "object",
        "required": [
          "who",
          "answer"
        ],
        "properties": {
          "who": {
            "type": "string"
          },
          "answer": {
            "type": "string",
            "description": "one of the answers the vote offers; the answer already given takes it back"
          }
        }
      },
      "Closer": {
        "type": "object",
        "required": [
          "who"
        ],
        "properties": {
          "who": {
            "type": "string",
            "description": "who is closing the vote; only its author can"
          }
        }
      }
    }
  }
}
