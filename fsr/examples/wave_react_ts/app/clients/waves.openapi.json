{
  "openapi": "3.0.3",
  "info": {
    "title": "Waves",
    "version": "1.0.0"
  },
  "paths": {
    "/waves": {
      "get": {
        "operationId": "listWaves",
        "parameters": [
          {
            "name": "view",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "who",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "the inbox, under one view",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Summary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/people": {
      "get": {
        "operationId": "listPeople",
        "responses": {
          "200": {
            "description": "everyone on any wave, and whether they are here now",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Person"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/waves/{id}": {
      "get": {
        "operationId": "getWave",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "one wave and every blip in it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Wave"
                }
              }
            }
          }
        }
      }
    },
    "/waves/{id}/blips/{blip}": {
      "patch": {
        "operationId": "editBlip",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "blip",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Rewritten"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "the blip as it now stands",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Blip"
                }
              }
            }
          }
        }
      }
    },
    "/waves/{id}/blips": {
      "post": {
        "operationId": "addBlip",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Written"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "the blip as it was kept",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Blip"
                }
              }
            }
          }
        }
      }
    },
    "/waves/{id}/game": {
      "post": {
        "operationId": "play",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Move"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "the board after the move",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Game"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Summary": {
        "type": "object",
        "required": [
          "id",
          "title",
          "participants",
          "blips",
          "last"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "participants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blips": {
            "type": "number",
            "format": "double"
          },
          "last": {
            "type": "string"
          }
        }
      },
      "Person": {
        "type": "object",
        "required": [
          "name",
          "here",
          "waves"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "here": {
            "type": "boolean"
          },
          "waves": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "Wave": {
        "type": "object",
        "required": [
          "id",
          "title",
          "participants",
          "blips",
          "game"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "participants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blips": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Blip"
            }
          },
          "game": {
            "$ref": "#/components/schemas/Game"
          }
        }
      },
      "Blip": {
        "type": "object",
        "required": [
          "id",
          "parent",
          "anchor",
          "who",
          "body",
          "at",
          "edited",
          "editors",
          "parts",
          "replies"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "parent": {
            "type": "string"
          },
          "anchor": {
            "type": "string",
            "description": "the block of the parent this answers, as the path the service gives it; empty for the whole blip"
          },
          "who": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "description": "the markdown as it was written"
          },
          "at": {
            "type": "string"
          },
          "edited": {
            "type": "string"
          },
          "editors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Part"
            },
            "description": "the body parsed on the server, with raw HTML kept as text"
          },
          "replies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Blip"
            },
            "description": "the replies to the whole blip, then any whose block is gone"
          }
        }
      },
      "Part": {
        "type": "object",
        "required": [
          "kind",
          "text",
          "href",
          "at",
          "children",
          "replies"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "description": "the element the part renders as; text for a run of text"
          },
          "text": {
            "type": "string",
            "description": "a text part's text, a code block's source or an image's alt"
          },
          "href": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "description": "the path of a block a reply can answer, empty for any other part"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Part"
            }
          },
          "replies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Blip"
            },
            "description": "the replies anchored to this block"
          }
        }
      },
      "Rewritten": {
        "type": "object",
        "required": [
          "who",
          "body"
        ],
        "properties": {
          "who": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        }
      },
      "Written": {
        "type": "object",
        "required": [
          "who",
          "parent",
          "anchor",
          "body"
        ],
        "properties": {
          "who": {
            "type": "string"
          },
          "parent": {
            "type": "string"
          },
          "anchor": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        }
      },
      "Move": {
        "type": "object",
        "required": [
          "who"
        ],
        "properties": {
          "who": {
            "type": "string"
          },
          "cell": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Cell": {
        "type": "object",
        "required": [
          "at",
          "mark"
        ],
        "properties": {
          "at": {
            "type": "integer",
            "format": "int64"
          },
          "mark": {
            "type": "string"
          }
        }
      },
      "Game": {
        "type": "object",
        "required": [
          "cells",
          "turn",
          "won"
        ],
        "properties": {
          "cells": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Cell"
            }
          },
          "turn": {
            "type": "string"
          },
          "won": {
            "type": "string"
          }
        }
      }
    }
  }
}
