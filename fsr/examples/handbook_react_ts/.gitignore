# written by `fsr build app`; rebuilt from routes/, schemas/ and clients/
app/generated/
app/tsconfig.json
app/tsconfig.build.json
# fetched by `fsr types`; read by the editor and tsc, never served
app/types/
# written by snapfirec; rebuilt from the sources
app/dist/
# written by `fsr test`: compiled spec files and test-only vendor builds
app/.fsr/
# written by generate/, the `[build] after` `fsr build app` and `fsr dev app` run: the whole site, documents and static roots
site/
