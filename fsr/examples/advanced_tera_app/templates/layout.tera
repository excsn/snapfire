<!doctype html>
<html lang="en"><head>{{ head() }}</head><body><nav><a class="brand" href="/">{{ nav_label }}</a><span class="links"><a href="/dash/servers">dash</a><a href="/slow/servers">slow</a><a href="/dash/down">down</a><a href="/hydrate">hydrate</a></span><span class="meters"><span class="pill visits" title="pages this session has visited, counted by the middleware">visits {{ visits }}</span><span class="pill renders" title="page renders since the server started">renders {{ renders }}</span></span>{% if identity is defined %}<span class="who">signed in as {{ identity.subject }}</span><form class="logout" method="post" action="/auth/logout"><input type="hidden" name="_csrf" value="{{ csrf_token | default(value="") }}"><button>log out</button></form>{% else %}<a class="login-link" data-sf-native href="/auth/login">log in</a>{% endif %}</nav><main>{{ slot(name="content") }}</main></body></html>
