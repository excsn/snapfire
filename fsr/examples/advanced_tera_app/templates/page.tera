<section class="page"><header class="page-head"><h1>{{ params.section }}</h1><p class="segment-render">this segment rendered at page render {{ renders }}</p></header><div class="grid"><article class="card"><h2>Servers</h2><table><thead><tr><th>name</th><th>load</th></tr></thead><tbody>{% for s in servers %}<tr><td>{{ s.name }}</td><td>{{ s.load }}</td></tr>{% endfor %}</tbody></table><form class="add" method="post" action="/_sf/action/add_server"><input name="name" placeholder="name" required><input name="load" value="0.5" inputmode="decimal"><input type="hidden" name="_csrf" value="{{ csrf_token | default(value="") }}"><button>add server</button></form></article><article class="card"><h2>Load</h2>{{ island(module="components/ServerChart.tsx#default", props=chart) }}</article></div></section>
