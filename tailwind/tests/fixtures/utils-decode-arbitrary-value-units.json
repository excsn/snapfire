  {
    "test": "decoding arbitrary values > should replace an underscore with a space",
    "function": "decodeArbitraryValue",
    "args": [
      "foo_bar"
    ],
    "post": null,
    "kind": "value",
    "expected": "foo bar"
  },
  {
    "test": "decoding arbitrary values > should replace multiple underscores with spaces",
    "function": "decodeArbitraryValue",
    "args": [
      "__foo__bar__"
    ],
    "post": null,
    "kind": "value",
    "expected": "  foo  bar  "
  },
  {
    "test": "decoding arbitrary values > should replace escaped underscores with a normal underscore",
    "function": "decodeArbitraryValue",
    "args": [
      "foo\\_bar"
    ],
    "post": null,
    "kind": "value",
    "expected": "foo_bar"
  },
