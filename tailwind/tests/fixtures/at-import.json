    "polyfills": null,
    "base": "/root",
    "stylesheet": null,
    "loads": [
      {
        "when": [
          {
            "arg": "base",
            "op": "eq",
            "value": "/root"
          },
          {
            "arg": "id",
            "op": "eq",
            "value": "./foo/bar.css"
          }
        ],
        "answer": [
          "\n          @import './bar/baz.css';\n        ",
          "/root/foo"
        ]
      },
      {
        "when": [
          {
            "arg": "base",
            "op": "eq",
            "value": "/root/foo"
          },
          {
            "arg": "id",
            "op": "eq",
            "value": "./bar/baz.css"
          }
        ],
        "answer": [
          "\n          .baz {\n            color: blue;\n          }\n        ",
          "/root/foo/bar"
        ]
      },
      {
        "when": [],
        "answer": null
      }
    ],
    "shuffled": false
