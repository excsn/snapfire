  {
    "test": "can resolve relative @imports",
    "kind": "css",
    "candidates": [],
    "css": "\n        @import './foo/bar.css';\n      ",
    "expected": "\n.foo {\n  color: red;\n}\n",
    "loader": false,
    "polyfills": null,
    "base": "/root",
    "stylesheet": null,
    "loads": [
      {
        "when": [
          {
            "arg": "base",
            "op": "ne",
            "value": "/root"
          }
        ],
        "answer": null
      },
      {
        "when": [
          {
            "arg": "id",
            "op": "ne",
            "value": "./foo/bar.css"
          }
        ],
        "answer": null
      },
      {
        "when": [],
        "answer": [
          "\n        .foo {\n          color: red;\n        }\n      ",
          "/root/foo"
        ]
      }
    ],
    "shuffled": false
  },
