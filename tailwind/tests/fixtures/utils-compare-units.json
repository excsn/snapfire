        "p-1.5",
        "p-10",
        "p-12",
        "p-2",
        "p-20",
        "p-21"
      ]
    ],
    "post": null,
    "kind": "snapshot",
    "expected": "[\n  \"p-0\",\n  \"p-0.5\",\n  \"p-1\",\n  \"p-1.5\",\n  \"p-2\",\n  \"p-10\",\n  \"p-12\",\n  \"p-20\",\n  \"p-21\",\n]"
  },
