[
  {
    "test": "expand(…) > should expand %s (%#) [0]",
    "function": "expand",
    "args": [
      "a/b/c"
    ],
    "post": "sort",
    "kind": "value",
    "expected": [
      "a/b/c"
    ]
  },
  {
    "test": "expand(…) > should expand %s (%#) [1]",
    "function": "expand",
    "args": [
      "a/{x,y,z}/b"
    ],
    "post": "sort",
    "kind": "value",
    "expected": [
      "a/x/b",
      "a/y/b",
      "a/z/b"
    ]
  },
  {
    "test": "expand(…) > should expand %s (%#) [2]",
    "function": "expand",
    "args": [
      "{a,b}/{x,y}"
    ],
    "post": "sort",
    "kind": "value",
    "expected": [
      "a/x",
      "a/y",
      "b/x",
      "b/y"
    ]
  },
  {
    "test": "expand(…) > should expand %s (%#) [3]",
