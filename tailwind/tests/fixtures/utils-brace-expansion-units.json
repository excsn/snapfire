  {
    "test": "expand(…) > throws on unbalanced braces",
    "function": "expand",
    "args": [
      "a{b,c{d,e},{f,g}h}x{y,z"
    ],
    "post": null,
    "kind": "error",
    "expected": "The pattern `x{y,z` is not balanced."
  },
  {
    "test": "expand(…) > throws when step is set to zero",
    "function": "expand",
    "args": [
      "a{0..5..0}/b"
    ],
    "post": null,
    "kind": "error",
    "expected": "Step cannot be zero in sequence expansion."
